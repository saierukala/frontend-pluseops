# PulseOps Frontend — Environment Variables
# Copy to .env.local and adjust for local development.
# See src/config/env.ts for validation and defaults.

# App
NEXT_PUBLIC_APP_NAME=PulseOps
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_DESCRIPTION=PulseOps — Business operations platform

# Backend API (no trailing slash)
# Must match PULSEOPS_FRONTEND_BACKEND_HANDOFF.md base: http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Realtime (Socket.IO) — same origin as API by default
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Feature flags (optional)
# NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Tenant — DEPRECATED. Do NOT use for authorization.
# Backend is authoritative via JWT scope (platform|tenant). Tenant login uses Workspace slug (tenantSlug).
# NEXT_PUBLIC_TENANT_ID is no longer read by the frontend auth flow. Remove from your environment.
# Example (deprecated): NEXT_PUBLIC_TENANT_ID=b74acd07-882a-4f58-b619-21dd23a81966
# NEXT_PUBLIC_TENANT_ID=

# Node environment
NODE_ENV=development
